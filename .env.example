# Copy to `.env` (read natively by Node 24). Every variable is validated in src/core/config/env.schema.ts.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# true when running behind a reverse proxy / load balancer (correct client IPs for rate limiting)
TRUST_PROXY=false

# `npm run db:up` starts this database (docker-compose.yml)
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_POOL_MAX=10

# At least 32 characters. Generate: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-0123456789
JWT_EXPIRES_IN_SECONDS=3600

# Comma-separated list of allowed browser origins (react-starter dev server by default)
CORS_ORIGINS=http://localhost:5173
# Defaults to true outside production
SWAGGER_ENABLED=true

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
