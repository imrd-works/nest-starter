{
  "name": "nest-starter",
  "author": "Daniel Rassomakhin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node dist/app/main.js",
    "verify": "npm run format:check && npm run lint:check && npm run typecheck && npm run test:unit && npm run openapi:check && npm run db:check && npm run knip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix --cache --max-warnings 0",
    "lint:check": "eslint . --cache --max-warnings 0 && secretlint \"**/*\"",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "test": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "openapi": "npm run build && node dist/app/openapi.js",
    "openapi:check": "npm run build && node dist/app/openapi.js --check",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && node scripts/check-migrations.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npm run build && node dist/app/seed.js",
    "generate:module": "node scripts/create-module.mjs",
    "prepare": "husky",
    "patch": "npm version patch -m \"chore(release): v%s\"",
    "minor": "npm version minor -m \"chore(release): v%s\"",
    "major": "npm version major -m \"chore(release): v%s\""
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.5",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@standard-schema/spec": "1.1.0",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "knip": "6.39.0",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "secretlint": "13.0.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.0"
    }
  }
}
